{
  "name": "campus-hub-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js",
    "preview:qa": "node scripts/preview-qa.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/*.mjs\" \"../server/src/*.js\" \"../server/test/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/*.mjs\" \"../server/src/*.js\" \"../server/test/*.js\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
